# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Your Anthropic API key (https://console.anthropic.com). The key lives ONLY on the server,
# never inside the mobile app.
ANTHROPIC_API_KEY=

# "claude" = real model calls. "mock" = canned responses, no key or spend needed (UI dev).
AI_PROVIDER=claude

# Model used for every step. Change here to try a different one.
CLAUDE_MODEL=claude-opus-5-5

PORT=3000

# Only needed for browser testing (Expo web). Native apps don't use CORS.
# CORS_ORIGINS=http://localhost:8081

# Rate limit per client IP across /api (each request can cost money).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MIN=15

# Set to the number of reverse-proxy hops once deployed behind one, so limits see the real IP.
# TRUST_PROXY=1
